@using JobLens.Web.Models
@using JobLens.Web.Services
@{
    ViewData["Title"] = "Dashboard";
    var goalPct = Model.WeeklyGoal == 0 ? 0 : Math.Min(100, Model.AppliedPastWeek * 100 / Model.WeeklyGoal);
    var remaining = Math.Max(0, Model.WeeklyGoal - Model.AppliedPastWeek);
}

<section class="welcome">
    <div>
        <p class="welcome-date">@Model.Today.ToString("dddd, d MMMM")</p>
        <h1 class="welcome-title">@Model.Greeting <span class="sparkle" aria-hidden="true">✿</span></h1>
        <p class="welcome-line">@Model.Encouragement</p>
    </div>
    <a class="btn btn-primary btn-lg" asp-controller="Applications" asp-action="Create">+ Log an application</a>
</section>

<section class="dash-grid">
    <article class="dash-card goal-card">
        <div class="goal-ring" style="--pct: @goalPct">
            <div class="goal-ring-inner">
                <strong>@Model.AppliedPastWeek</strong>
                <span>of @Model.WeeklyGoal</span>
            </div>
        </div>
        <div>
            <h2 class="dash-card-title">Past week</h2>
            <p class="dash-muted">
                @if (remaining == 0)
                {
                    <text>Wowww goal met already? How disciplined</text>
                }
                else
                {
                    <text>@remaining more to reach your goal. Gotta beat unemployment gang.</text>
                }
            </p>
            <div class="goal-petals" aria-hidden="true">
                @for (var i = 0; i < Model.WeeklyGoal; i++)
                {
                    <span class="@(i < Model.AppliedPastWeek ? "on" : "")"></span>
                }
            </div>
        </div>
    </article>

    <article class="dash-card streak-card">
        <p class="dash-label">Day streak</p>
        <p class="streak-number">@Model.DayStreak</p>
        <p class="dash-muted">
            @((Model.DayStreak, Model.SentToday) switch
            {
                (0, _) => "Start the streak by sending an application. NOW",
                (_, false) => "Ight light up the streak with one!",
                (1, _) => "day in a row, let's go!",
                _ => "days in a row, hell yea!"
            })
        </p>
    </article>

    <article class="dash-card stats-card">
        <div class="stat"><span class="stat-num">@Model.Total</span><span class="stat-label">Sent, all time</span></div>
        <div class="stat"><span class="stat-num">@(Model.ResponseRate is { } rate ? $"{rate}%" : "—")</span><span class="stat-label">Response rate</span></div>
        <div class="stat"><span class="stat-num">@Model.Active</span><span class="stat-label">It's goin</span></div>
        <div class="stat"><span class="stat-num">@Model.Interviews</span><span class="stat-label">Interviews</span></div>
        <div class="stat"><span class="stat-num">@Model.Offers</span><span class="stat-label">Offers</span></div>
        <div class="stat"><span class="stat-num">@Model.Stale.Count</span><span class="stat-label">Send a follow up?</span></div>
    </article>
</section>

<section class="dash-columns">
    <article class="dash-card">
        <div class="dash-card-head">
            <h2 class="dash-card-title">Up next</h2>
            <span class="dash-muted small">follow-ups &amp; to-dos</span>
        </div>
        @if (Model.UpNext.Count == 0)
        {
            <p class="dash-empty">Nothing waiting on you. Set a next-action date on an application and it'll show up here.</p>
        }
        else
        {
            <ul class="dash-list">
                @foreach (var a in Model.UpNext)
                {
                    var due = DateLabels.Due(a.NextActionDate, Model.Today);
                    <li>
                        <a asp-controller="Applications" asp-action="Edit" asp-route-id="@a.Id">
                            <span class="dash-list-main">
                                <strong>@a.Role</strong>
                                <span>@a.Employer</span>
                            </span>
                            <span class="due-pill @due.CssClass">@due.Text</span>
                        </a>
                    </li>
                }
            </ul>
        }
    </article>

    <article class="dash-card">
        <div class="dash-card-head">
            <h2 class="dash-card-title">Recently sent</h2>
            <a class="small" asp-controller="Applications" asp-action="Index">See all</a>
        </div>
        @if (Model.Recent.Count == 0)
        {
            <p class="dash-empty">Find your applications here!</p>
        }
        else
        {
            <ul class="dash-list">
                @foreach (var a in Model.Recent)
                {
                    <li>
                        <a asp-controller="Applications" asp-action="Edit" asp-route-id="@a.Id">
                            <span class="dash-list-main">
                                <strong>@a.Role</strong>
                                <span>@a.Employer · @a.DateApplied.ToString("d MMM")</span>
                            </span>
                            <span class="badge status-@a.Status">@a.Status.Label()</span>
                        </a>
                    </li>
                }
            </ul>
        }
    </article>
</section>

@if (Model.Stale.Count > 0)
{
    <section class="dash-card stale-card">
        <div class="dash-card-head">
            <h2 class="dash-card-title">Worth chasing?</h2>
            <span class="dash-muted small">no reply after @DashboardStats.StaleAfterDays days</span>
        </div>
        <ul class="dash-list">
            @foreach (var a in Model.Stale.Take(5))
            {
                <li>
                    <a asp-controller="Applications" asp-action="Edit" asp-route-id="@a.Id">
                        <span class="dash-list-main">
                            <strong>@a.Role</strong>
                            <span>@a.Employer · sent @a.DateApplied.ToString("d MMM")</span>
                        </span>
                        <span class="due-pill due-soon">@DateLabels.Ago(a.DateApplied, Model.Today)</span>
                    </a>
                </li>
            }
        </ul>
        @if (Model.Stale.Count > 5)
        {
            <p class="dash-muted small stale-more">and @(Model.Stale.Count - 5) more. A quick follow-up email can go a long way.</p>
        }
    </section>
}

@if (Model.Total > 0)
{
    <section class="dash-card pipeline-card">
        <h2 class="dash-card-title">Current Progress</h2>
        <div class="pipeline-bar">
            @foreach (var s in StatusLabels.Ordered)
            {
                if (Model.ByStatus.TryGetValue(s, out var n) && n > 0)
                {
                    <span class="status-@s" style="flex: @n" title="@s.Label(): @n"></span>
                }
            }
        </div>
        <ul class="pipeline-legend">
            @foreach (var s in StatusLabels.Ordered)
            {
                Model.ByStatus.TryGetValue(s, out var n);
                <li><span class="legend-dot status-@s"></span>@s.Label() <strong>@n</strong></li>
            }
        </ul>
    </section>
}
