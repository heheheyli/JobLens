@model JobLens.Web.Models.JobApplication

@{
    ViewData["Title"] = "New application";
    ViewData["SubmitLabel"] = "Save application";
}

<div class="form-page-head">
    <a asp-action="Index" class="back-link">← Applications</a>
    <h1>New application</h1>
    <p class="form-page-sub">Only the employer and job title are required. Everything else is a bonus.</p>
</div>

<form asp-action="Create" class="app-form" novalidate>
    <partial name="_ApplicationForm" model="Model" />
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/application-form.js" asp-append-version="true"></script>
}
